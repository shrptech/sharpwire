# Copy to .env for local development. Every setting without a default must be set, or the app refuses to start.
# In production, secrets come from mounted files instead (see app/config.py: SHARPWIRE_SECRETS_DIR or systemd's
# CREDENTIALS_DIRECTORY), one file per setting, named after the setting.

DATABASE_URL=postgresql+asyncpg://sharpwire:sharpwire@localhost:5433/sharpwire

# NetBox (the intent source). Pinned to 4.7, like sharpstack.
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=change-me
# At least 16 characters, like API_TOKEN below.
NETBOX_WEBHOOK_SECRET=change-me-to-a-long-secret

# The RouterOS service account (the same on every core and leaf) and the CA its devices' certificates come from.
ROUTEROS_USERNAME=sharpwire
ROUTEROS_PASSWORD=change-me
ROUTEROS_CA_FILE=/path/to/routeros-ca.pem

# Bearer token for the read-only JSON API, until the operator UI's Kanidm login.
API_TOKEN=change-me-to-a-long-token
